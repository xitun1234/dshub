# fly.toml app configuration file generated for xskt-manager on 2026-03-15T02:43:12+07:00
#
# See https://fly.io/docs/reference/configuration/ for information about how to use this file.
#

app = 'xskt-manager'
primary_region = 'sin'

[deployment]
  strategy = "recreate"

[build]

[env]
  DATABASE_URL = 'file:/data/database.sqlite'

[[mounts]]
  source = 'data_volume'
  destination = '/data'

[http_service]
  internal_port = 3000
  force_https = true
  auto_stop_machines = 'stop'
  auto_start_machines = true
  min_machines_running = 0

[[vm]]
  memory = '512mb'
  cpus = 1
  memory_mb = 512
